// This is your Prisma schema file
// Learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String       @id @default(uuid())
  email        String?      @unique
  mobile       String?      @unique
  fullName     String
  passwordHash String
  preferredLang String      @default("en")
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  complaints   Complaint[]
  notifications Notification[]

  @@map("users")
}

model Department {
  id          String       @id @default(uuid())
  name        String       @unique
  code        String       @unique
  description String?
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  complaints  Complaint[]

  @@map("departments")
}

model Complaint {
  id              String            @id @default(uuid())
  ticketId        String            @unique
  userId          String
  user            User              @relation(fields: [userId], references: [id])
  departmentId    String?
  department      Department?       @relation(fields: [departmentId], references: [id])
  
  originalText    String
  language        String            @default("en")
  category        String?
  urgency         ComplaintUrgency  @default(MEDIUM)
  status          ComplaintStatus   @default(PENDING)
  
  photoUrl        String?
  locality        String?
  address         String?
  
  aiCategory      String?
  aiDepartment    String?
  aiUrgency       String?
  aiConfidence    Float?
  aiProcessed     Boolean           @default(false)
  translatedText  String?           // English translation of originalText (produced by AI)
  estimatedDays   Int?              // Estimated resolution days from lookup table
  detectedLang    String?           // Language code detected by AI (may differ from user selection)
  
  assignedTo      String?
  officialRemarks String?
  resolution      String?
  
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  resolvedAt      DateTime?
  
  statusHistory   ComplaintStatusHistory[]

  @@map("complaints")
}

model ComplaintStatusHistory {
  id          String          @id @default(uuid())
  complaintId String
  complaint   Complaint       @relation(fields: [complaintId], references: [id])
  status      ComplaintStatus
  remarks     String?
  changedBy   String          // admin id or "system"
  changedAt   DateTime        @default(now())

  @@map("complaint_status_history")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("notifications")
}

enum ComplaintStatus {
  PENDING
  IN_PROGRESS
  RESOLVED
  REJECTED
}

enum ComplaintUrgency {
  LOW
  MEDIUM
  HIGH
}
