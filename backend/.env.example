# Backend Environment Variables
DATABASE_URL="postgresql://mgrs_user:mgrs_password@localhost:5432/mgrs_db"

# JWT Secret (use a long random string in production)
JWT_SECRET="change_this_to_a_long_random_secret_in_production"
JWT_EXPIRES_IN="7d"

# Admin Credentials (change before deployment!)
ADMIN_ID="admin@mgrs.gov"
# Generate hash: node -e "const b=require('bcryptjs'); b.hash('admin123',12).then(console.log)"
ADMIN_PASSWORD_HASH="$2b$12$REPLACE_WITH_ACTUAL_BCRYPT_HASH"

# Server
PORT=5000
NODE_ENV=development
FRONTEND_URL="http://localhost:3000"

# File Upload
MAX_FILE_SIZE=5242880
UPLOAD_DIR="./uploads"

# AI Service
AI_SERVICE_URL="http://localhost:8000"
